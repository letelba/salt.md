# Set secrets in your deployment secret store. Removing the issuer disables OIDC.
SALT_OIDC_ISSUER=https://identity.example/realms/team
SALT_OIDC_CLIENT_ID=notes
SALT_OIDC_CLIENT_SECRET=
SALT_OIDC_REDIRECT_URL=https://notes.example/api/oidc/callback
SALT_OIDC_NAME=Team Login
SALT_OIDC_IDENTITY_CLAIM=stable_user_id
SALT_OIDC_ACCOUNT_LINKS={"approved-immutable-id":"existing-native-user-id"}
SALT_OIDC_REQUIRED_ENTITLEMENT=notes
SALT_OIDC_REQUIRED_ROLE=notes.user
SALT_OIDC_REQUIRED_TEAM_ID=T_APPROVED
# Comma-separated base64url encodings of 32 random bytes; first key encrypts.
SALT_OIDC_SESSION_KEYS=
# Fixed session maximum: 2592000s; authorization freshness: <=600s.
# Persistent opaque Secure/HttpOnly/SameSite=Lax cookie; shared SQLite under SALT_DATA.
# Preserve native password recovery; OIDC never provisions accounts/membership.
# Register only the exact callback and public root as the post-logout URL.
